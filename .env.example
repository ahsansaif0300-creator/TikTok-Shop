DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
PORT="3000"
# Leave unset behind HTTPS so the session cookie is Secure.
# Set to false only when you serve the app over plain HTTP (local `next start`).
# AUTH_COOKIE_SECURE="false"
# Extra hosts allowed for Server Actions / Next dev (comma-separated), e.g. a LAN hostname.
# ALLOWED_ORIGINS="my-pc.local"
# Public origin used when printing shop links (no trailing slash).
# APP_BASE_URL="https://your-app.hostingersite.com"
# Optional apex domain for per-shop hosts like northline.yourdomain.com (needs wildcard DNS).
# SHOP_BASE_DOMAIN="yourdomain.com"
